# Copy to ".streamlit/secrets.toml" for local use, or paste the same text into
# Streamlit Community Cloud > your app > Settings > Secrets.
# The real secrets.toml is ignored by Git. Never commit passwords.

[mysql]
host = "your-service.aivencloud.com"
port = 12345
name = "defaultdb"
user = "rms_app"
password = "REPLACE_ME"
ssl_ca = """-----BEGIN CERTIFICATE-----
PASTE THE CA CERTIFICATE FROM YOUR DATABASE PROVIDER HERE
-----END CERTIFICATE-----"""

# One section per login user. Create each hash with: python scripts/make_password_hash.py
[users.admin]
password_hash = "pbkdf2_sha256$...paste hash..."
role = "admin"
display_name = "Administrator"
employee_id = 12          # optional: employee recorded in the status history for this user

[users.supervisor]
password_hash = "pbkdf2_sha256$...paste hash..."
role = "viewer"
display_name = "Supervisor (read only)"
