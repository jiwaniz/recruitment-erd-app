# Copy this file to ".env" and fill in your own values. ".env" is ignored by Git.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=recruitment_erd_db
DB_USER=your_local_user
DB_PASSWORD=your_local_password

# Only for cloud databases that require TLS (see DEPLOYMENT_GUIDE.md):
# DB_SSL=true
# DB_SSL_CA=C:/path/to/ca.pem

# Login users for the web application, as one line of JSON.
# Create each password_hash with:  python scripts/make_password_hash.py
# Roles: viewer (read only), recruiter (add/edit), admin (approve/delete)
APP_USERS={"admin": {"password_hash": "PASTE_HASH_HERE", "role": "admin", "display_name": "Administrator", "employee_id": 12}}

# Optional: email service for "Forgot password" (see AUTH_SETUP.md)
# APP_BASE_URL=http://localhost:8501
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURITY=starttls
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=noreply@example.com
